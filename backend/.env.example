# 个人财务管理应用 - 环境变量配置模板
# 请复制此文件为 .env 并修改相应配置

# 应用配置
NODE_ENV=development
PORT=4000
APP_HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=personal-finance-app
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Redis配置 (可选)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT认证配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_key_at_least_32_characters
JWT_REFRESH_EXPIRATION=30d

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# 加密配置 (AES-256)
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_IV=your_16_character_iv_here

# 备份配置
BACKUP_PATH=./backups
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=json

# Swagger API文档配置
SWAGGER_TITLE=个人财务管理 API
SWAGGER_DESCRIPTION=个人财务管理应用程序接口文档
SWAGGER_VERSION=1.0.0

# 本地LLM配置
OLLAMA_MODEL=qwen2.5:1.8b
OLLAMA_PULL_TIMEOUT_MS=30000
